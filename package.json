{
  "name": "yarb-web3",
  "version": "1.0.0",
  "description": "基于 GitHub 目录结构的动态文章展示网站",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "axios": "^1.13.6",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "github-api",
    "markdown",
    "blog",
    "yarb-web3"
  ],
  "author": "dubuqingfeng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dubuqingfeng/yarb-web3.git"
  },
  "homepage": "https://github.com/dubuqingfeng/yarb-web3#readme",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=10.31.0"
  },
  "pnpm": {
    "minimumReleaseAge": 1440,
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
